# Copy this file to .env and edit it. .env is not committed; all code reads its folders from it.

# Any name you like. Your checkpoints go in $RFI_CHECKPOINTS_ROOT/$RFI_NAME and your runs are tagged with it.
RFI_NAME=your-name

# The dataset: the folder that contains dataset.csv.
RFI_DATA_DIR=/resnick/groups/mlprojects/rfi-removal-project/data/starter-v1.0

# Shared checkpoint folder, one subfolder per person.
RFI_CHECKPOINTS_ROOT=/resnick/groups/mlprojects/rfi-removal-project/model_checkpoints
